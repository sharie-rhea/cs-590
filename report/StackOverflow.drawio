        <mxCell id="dEpcquroDIxG1rHjCJiK-123" parent="dEpcquroDIxG1rHjCJiK-120" style="text;html=1;whiteSpace=wrap;strokeColor=none;fillColor=none;align=center;verticalAlign=middle;rounded=0;fontSize=19;" value="09:22AM 06/19/2026" vertex="1">
