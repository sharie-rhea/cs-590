        <mxCell id="dEpcquroDIxG1rHjCJiK-512" parent="dEpcquroDIxG1rHjCJiK-7" style="shape=image;html=1;verticalAlign=top;verticalLabelPosition=bottom;labelBackgroundColor=#ffffff;imageAspect=0;aspect=fixed;image=https://icons.diagrams.net/icon-cache1/Arrow_Outline-2875/left_3-1362.svg" value="" vertex="1">
